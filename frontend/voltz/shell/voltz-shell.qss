/* Todas as regras prefixadas com #voltzShell para vencer o tema global do OBS (Yami etc.). */

#voltzShell, #voltzShell QWidget {
	background: #09090B;
	color: #F2F2F3;
	font-family: "DM Sans", "Segoe UI";
	font-size: 13px;
}

#voltzShell QLabel {
	background: transparent;
}

#voltzShell QFrame#sideNav {
	background: #111114;
	border: none;
	border-right: 1px solid #1F1F24;
}

#voltzShell QFrame#sideNav QToolButton {
	background: transparent;
	color: #82828C;
	border: none;
	border-radius: 8px;
	padding: 8px 2px 6px 2px;
	margin: 0;
	font-size: 11px;
	font-weight: 500;
}

#voltzShell QFrame#sideNav QToolButton:hover {
	color: #F2F2F3;
	background: #18181C;
}

#voltzShell QFrame#sideNav QToolButton:checked {
	color: #D4F53C;
	background: rgba(212, 245, 60, 26);
}

#voltzShell QFrame#panel {
	background: #111114;
	border: 1px solid #1F1F24;
	border-radius: 8px;
}

#voltzShell QFrame#panel QWidget {
	background: transparent;
}

#voltzShell QLabel#panelTitle {
	color: #82828C;
	font-size: 10px;
	font-weight: 600;
}

#voltzShell QLabel#muted {
	color: #82828C;
}

#voltzShell QLabel#pageTitle {
	font-size: 20px;
	font-weight: 700;
}

#voltzShell QListWidget {
	background: transparent;
	border: none;
	outline: none;
	padding: 0;
}

#voltzShell QListWidget::item {
	padding: 6px 8px;
	border: none;
	border-radius: 4px;
	color: #F2F2F3;
}

#voltzShell QListWidget::item:hover {
	background: #18181C;
}

#voltzShell QListWidget::item:selected {
	background: rgba(212, 245, 60, 26);
	color: #F2F2F3;
	border-left: 2px solid #D4F53C;
}

#voltzShell QFrame#bottomBar {
	background: #111114;
	border: none;
	border-top: 1px solid #1F1F24;
}

#voltzShell QPushButton {
	background: #18181C;
	color: #F2F2F3;
	border: 1px solid #1F1F24;
	border-radius: 16px;
	padding: 7px 16px;
	margin: 0;
	min-height: 18px;
	max-height: 16777215px;
}

#voltzShell QPushButton:hover {
	border-color: #3A3A42;
}

#voltzShell QPushButton:disabled {
	color: #4A4A52;
}

#voltzShell QPushButton#drawButton:checked {
	border-color: #D4F53C;
	color: #D4F53C;
}

#voltzShell QPushButton#recordButton {
	background: #FF4D4D;
	color: #FFFFFF;
	border: none;
	font-weight: 600;
	padding: 8px 22px;
}

#voltzShell QPushButton#recordButton[recording="true"] {
	background: #F2F2F3;
	color: #09090B;
}

#voltzShell QPushButton#recordButton:disabled {
	background: #3A3A42;
	color: #82828C;
}

#voltzShell QToolButton#iconButton {
	background: transparent;
	border: none;
	border-radius: 6px;
	padding: 4px;
	margin: 0;
}

#voltzShell QToolButton#iconButton:hover {
	background: #18181C;
}

#voltzShell QToolButton#iconButton:disabled {
	background: transparent;
}

/* foco do teclado visível (Tab); padding 1 px menor para o botão não mudar de tamanho com a borda */
#voltzShell QToolButton#iconButton:focus {
	border: 1px solid #D4F53C;
	padding: 3px;
}

#voltzShell QFrame#errorBanner {
	background: rgba(255, 77, 77, 31);
	border: 1px solid rgba(255, 77, 77, 102);
	border-radius: 8px;
}

#voltzShell QFrame#errorBanner QLabel {
	color: #F2F2F3;
}

#voltzShell QLabel#errorTitle {
	font-weight: 600;
}

#voltzShell QFrame#errorBanner[warning="true"] {
	background: rgba(245, 200, 60, 26);
	border: 1px solid rgba(245, 200, 60, 102);
}

#voltzShell QLabel#timeLabel {
	color: #82828C;
	font-family: "Cascadia Mono", "Consolas";
}

#voltzShell QLabel#markerToast {
	color: #D4F53C;
	font-weight: 600;
}

#voltzShell QLabel#spaceLabel {
	color: #82828C;
	font-size: 12px;
}

#voltzShell QComboBox#projectName QLineEdit {
	background: transparent;
	border: none;
	padding: 0;
	color: #F2F2F3;
}

#voltzShell OBSQTDisplay {
	qproperty-displayBackgroundColor: #09090B;
}

#voltzShell QFrame#presetCard {
	background: #111114;
	border: 1px solid #1F1F24;
	border-radius: 10px;
}

#voltzShell QFrame#presetCard:hover {
	border-color: #3A3A42;
}

#voltzShell QFrame#presetCard QWidget {
	background: transparent;
}

#voltzShell QLabel#cardTitle {
	font-size: 15px;
	font-weight: 600;
}

#voltzShell QFrame#welcomeBanner,
#voltzShell QFrame#recoverBanner {
	background: rgba(212, 245, 60, 20);
	border: 1px solid rgba(212, 245, 60, 90);
	border-radius: 8px;
}

/* Seletor extra: "#presetCard QWidget" (transparente) tem especificidade maior que "QPushButton#primaryButton". */
#voltzShell QPushButton#primaryButton,
#voltzShell QFrame#presetCard QPushButton#primaryButton {
	background: #D4F53C;
	color: #09090B;
	border: none;
	font-weight: 600;
}

#voltzShell QPushButton#primaryButton:hover,
#voltzShell QFrame#presetCard QPushButton#primaryButton:hover {
	background: #E2FA6A;
}

#voltzShell QScrollArea {
	background: transparent;
	border: none;
}

#voltzShell QTreeWidget#projectsList {
	background: #111114;
	border: 1px solid #1F1F24;
	border-radius: 8px;
	outline: none;
}

#voltzShell QTreeWidget#projectsList::item {
	padding: 6px 22px 6px 4px;
	color: #F2F2F3;
}

#voltzShell QTreeWidget#projectsList::item:selected {
	background: rgba(212, 245, 60, 26);
	color: #F2F2F3;
}

#voltzShell QHeaderView::section {
	background: #111114;
	color: #82828C;
	border: none;
	border-bottom: 1px solid #1F1F24;
	padding: 6px 22px 6px 4px;
	font-size: 11px;
}

#voltzShell QHeaderView::down-arrow {
	image: url(:/voltz/icons/qss/caret-down-accent.svg);
	width: 9px;
	height: 9px;
	subcontrol-origin: padding;
	subcontrol-position: center right;
	right: 6px;
}

#voltzShell QHeaderView::up-arrow {
	image: url(:/voltz/icons/qss/caret-up-accent.svg);
	width: 9px;
	height: 9px;
	subcontrol-origin: padding;
	subcontrol-position: center right;
	right: 6px;
}

#voltzShell QComboBox {
	background: #18181C;
	color: #F2F2F3;
	border: 1px solid #1F1F24;
	border-radius: 6px;
	padding: 5px 30px 5px 10px;
	min-height: 18px;
	max-height: 16777215px;
}

#voltzShell QComboBox:hover {
	border-color: #3A3A42;
}

#voltzShell QComboBox:disabled {
	color: #4A4A52;
}

#voltzShell QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: center right;
	width: 26px;
	border: none;
	background: transparent;
}

#voltzShell QComboBox::down-arrow {
	image: url(:/voltz/icons/qss/caret-down-muted.svg);
	width: 12px;
	height: 12px;
}

#voltzShell QComboBox QAbstractItemView {
	background: #111114;
	color: #F2F2F3;
	border: 1px solid #1F1F24;
	selection-background-color: rgba(212, 245, 60, 40);
}

#voltzShell QCheckBox {
	background: transparent;
	spacing: 8px;
}

#voltzShell QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border: 1px solid #3A3A42;
	border-radius: 4px;
	background: #18181C;
}

#voltzShell QCheckBox::indicator:hover {
	border-color: #82828C;
}

#voltzShell QCheckBox::indicator:checked {
	background: #D4F53C;
	border-color: #D4F53C;
	image: url(:/voltz/icons/qss/check-dark.svg);
}

#voltzShell QCheckBox::indicator:checked:hover {
	background: #E2FA6B;
	border-color: #E2FA6B;
}

#voltzShell QCheckBox::indicator:disabled {
	background: #111114;
	border-color: #1F1F24;
}

#voltzShell QCheckBox::indicator:checked:disabled {
	background: #4A4A52;
	border-color: #4A4A52;
}

#voltzShell QCheckBox:disabled {
	color: #4A4A52;
}

#voltzShell QLabel#dialogTitle {
	font-size: 15px;
	font-weight: 600;
}

#voltzShell QPushButton#dangerButton {
	background: #FF4D4D;
	color: #FFFFFF;
	border: none;
	font-weight: 600;
}

#voltzShell QPushButton#dangerButton:hover {
	background: #FF6666;
}

/* --- Painel de Áudio: VolumeControl do OBS dentro da casca --- */
#voltzShell VolumeControl {
	background: transparent;
}

#voltzShell VolumeName {
	background: transparent;
	border: none;
	padding: 2px 0;
}

#voltzShell VolumeName QLabel {
	font-size: 12px;
	font-weight: 600;
	color: #F2F2F3;
}

#voltzShell VolumeName::down-arrow {
	image: url(:/voltz/icons/qss/caret-down-muted.svg);
	width: 10px;
	height: 10px;
}

#voltzShell VolumeControl QLabel#volLabel {
	color: #82828C;
	font-size: 11px;
	min-width: 48px;
}

#voltzShell VolumeMeter {
	font-size: 8px;
	color: #82828C;
	qproperty-majorTickColor: #82828C;
	qproperty-minorTickColor: #3A3A42;
	qproperty-backgroundNominalColor: #2F3712;
	qproperty-backgroundWarningColor: #4A4013;
	qproperty-backgroundErrorColor: #4A1A1A;
	qproperty-foregroundNominalColor: #D4F53C;
	qproperty-foregroundWarningColor: #F5C83C;
	qproperty-foregroundErrorColor: #FF4D4D;
	qproperty-backgroundNominalColorDisabled: #2C2C34;
	qproperty-backgroundWarningColorDisabled: #34343C;
	qproperty-backgroundErrorColorDisabled: #26262D;
	qproperty-foregroundNominalColorDisabled: #82828C;
	qproperty-foregroundWarningColorDisabled: #9A9AA3;
	qproperty-foregroundErrorColorDisabled: #6A6A73;
}

#voltzShell VolumeControl QSlider::groove:horizontal {
	background: #1F1F24;
	height: 4px;
	border: none;
	border-radius: 2px;
}

#voltzShell VolumeControl QSlider::sub-page:horizontal {
	background: #D4F53C;
	border-radius: 2px;
}

#voltzShell VolumeControl QSlider::sub-page:horizontal:disabled {
	background: #3A3A42;
}

#voltzShell VolumeControl QSlider::handle:horizontal {
	background: #F2F2F3;
	width: 12px;
	height: 12px;
	margin: -4px 0;
	border-radius: 6px;
}

#voltzShell VolumeControl QSlider::handle:horizontal:hover {
	background: #FFFFFF;
}

#voltzShell VolumeControl QPushButton.btn-mute,
#voltzShell VolumeControl QPushButton.btn-monitor {
	background: transparent;
	border: none;
	border-radius: 6px;
	padding: 4px;
	margin: 0 2px;
	min-height: 0;
	icon-size: 16px;
}

#voltzShell VolumeControl QPushButton.btn-mute:hover,
#voltzShell VolumeControl QPushButton.btn-monitor:hover {
	background: #18181C;
}

#voltzShell VolumeControl QPushButton.btn-mute {
	qproperty-icon: url(:/voltz/icons/qss/speaker-high-text.svg);
}

#voltzShell VolumeControl QPushButton.btn-mute.checked {
	qproperty-icon: url(:/voltz/icons/qss/speaker-slash-rec.svg);
}

#voltzShell VolumeControl QPushButton.btn-monitor {
	qproperty-icon: url(:/voltz/icons/qss/headphones-muted.svg);
}

#voltzShell VolumeControl QPushButton.btn-monitor.checked {
	background: rgba(212, 245, 60, 26);
	qproperty-icon: url(:/voltz/icons/qss/headphones-accent.svg);
}

/* por último: aviso (fonte sem trilha ou só monitor) vence o estado de mudo */
#voltzShell VolumeControl QPushButton.btn-mute.mute-warning {
	qproperty-icon: url(:/voltz/icons/qss/warning-circle-warn.svg);
}

/* Ajustes › Mouse: sliders no visual dos do Áudio; botão de cor com amostra */
#voltzShell QSlider#mouseSlider::groove:horizontal {
	background: #1F1F24;
	height: 4px;
	border: none;
	border-radius: 2px;
}

#voltzShell QSlider#mouseSlider::sub-page:horizontal {
	background: #D4F53C;
	border-radius: 2px;
}

#voltzShell QSlider#mouseSlider::sub-page:horizontal:disabled {
	background: #3A3A42;
}

#voltzShell QSlider#mouseSlider::handle:horizontal {
	background: #F2F2F3;
	width: 12px;
	height: 12px;
	margin: -4px 0;
	border-radius: 6px;
}

#voltzShell QSlider#mouseSlider::handle:horizontal:hover {
	background: #FFFFFF;
}

#voltzShell QPushButton#colorButton {
	padding: 5px 12px;
	text-align: left;
}

/* Ajustes › Atalhos (Plano 4D): o campo de teclas do OBS (OBSHotkeyEdit) e o aviso de cada atalho */
#voltzShell QLineEdit#hotkeyEdit {
	background: #18181C;
	color: #F2F2F3;
	border: 1px solid #1F1F24;
	border-radius: 8px;
	padding: 5px 10px;
	min-width: 200px;
}

#voltzShell QLineEdit#hotkeyEdit:focus {
	border-color: #D4F53C;
}

#voltzShell QLabel#hotkeyStatus {
	color: #82828C;
}

#voltzShell QLabel#hotkeyStatus[warn="true"] {
	color: #F5C83C;
}

/* Ajustes › Anotações (Plano 4D): estado das anotações (fora da gravação da tela; "queimadas" e fonte em amarelo) */
#voltzShell QLabel#annotStatus {
	color: #82828C;
}

#voltzShell QLabel#annotStatus[warn="true"] {
	color: #F5C83C;
}
